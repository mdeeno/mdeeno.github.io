<script>
  (function() {
    // 1. 초기화 (전역 변수 충돌 방지를 위해 즉시 실행 함수로 감쌉니다)
    const supabaseUrl = 'https://ohmybbgvdlqgyvuvmewz.supabase.co';
    const supabaseKey = 'REDACTED_SUPABASE_ANON_KEY';

    // 중복 선언 방지: window 객체에 할당하여 관리
    if (!window.supabaseClient) {
      const { createClient } = window.supabase;
      window.supabaseClient = createClient(supabaseUrl, supabaseKey);
    }

    // 2. 이벤트 리스너 등록
    document.addEventListener('DOMContentLoaded', function() {
      const form = document.getElementById('supabase-lead-form');
      
      if (form && !form.dataset.attached) {
        form.dataset.attached = "true"; // 중복 이벤트 방지 플래그
        
        form.addEventListener('submit', async function(e) {
          e.preventDefault(); 
          e.stopPropagation();

          const emailInput = this.querySelector('.email-input');
          const submitBtn = this.querySelector('.email-btn');
          const email = emailInput.value;

          if (!email) return;

          submitBtn.innerText = '전송 중...';
          submitBtn.disabled = true;

          try {
            const { error } = await window.supabaseClient
              .from('lead_emails')
              .insert([{ 
                email: email, 
                source: 'home_landing' 
              }]);

            if (error) throw error;

            alert('📩 신청이 완료되었습니다!');
            emailInput.value = '';

          } catch (err) {
            console.error('전송 실패:', err.message);
            alert('오류가 발생했습니다: ' + err.message);
          } finally {
            submitBtn.innerText = 'PDF 받기';
            submitBtn.disabled = false;
          }
        });
      }
    });
  })();
</script>
{{ end }}

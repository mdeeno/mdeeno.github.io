<file path="assets/css/lab-style.css">
/* ------ [기본 설정: 다크 고정] ------ */
:root {
  box-sizing: border-box;
  color: #e4e4e4;
}

/* 텍스트 가독성 최적화 */
.lab-text,
.lab-small-text,
.lab-subtitle {
  color: var(--primary); /* PaperMod 기본 밝은 텍스트 */
}
.lab-intro-section {
  max-width: 800px;
  margin: 10px auto;
  padding: 20px;
  font-family: sans-serif;
  color: var(--primary);
}

/* ------ [헤더 및 제목, 내용 폰트] ------ */
.lab-header {
  text-align: center;
  border-bottom: 3px solid #0056b3;
  padding-bottom: 30px;
  margin-bottom: 40px;
}
.lab-title {
  font-size: clamp(1.8rem, 4vw, 2.5rem) !important;
  color: #4dabf7;
  font-weight: 800;
  margin-bottom: 10px;
}
.lab-section-title {
  font-size: clamp(1.3rem, 4vw, 2rem) !important;
  color: #fff;
  border-left: 5px solid #0056b3;
  padding-left: 15px;
  margin: 40px 0 20px;
}
.lab-subtitle {
  font-size: clamp(1.3rem, 4vw, 2rem) !important;
  color: #fff;
  font-weight: 800;
}
.lab-text {
  font-size: 1.05rem;
  line-height: 1.8;
  color: #fff;
}
.lab-small-text {
  font-size: 0.8rem;
  line-height: 1.5;
  color: #fff;
}
.lab-subtle-label {
  font-size: 0.85rem;
  color: #9aa4b2;
  font-weight: 500;
}

/* ------- [수식 및 점수판] ------- */
.lab-formula-box {
  background: var(--entry);
  font-size: clamp(0.8rem, 4vw, 1.8rem) !important;
  color: #eee;
  padding: 15px;
  border-radius: 12px;
  margin: 40px 0;
  text-align: center;
  border: 1px solid var(--border);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
}
/* 수학 공식 - 가변크기 적용 */
.lab-formula-text {
  font-size: clamp(0.8rem, 4vw, 1.8rem) !important;

  background-color: #ffffffda;
  padding: 2px;
  margin: 10px 0;

  color: #141517;
  transition: font-size 0.2s ease-in-out;
}
.lab-formula-caption {
  font-size: 0.9rem;
  color: #aaa;
}

.lab-score-display {
  font-size: clamp(2.5rem, 8vw, 3.5rem);
  font-weight: 900;
  color: #ffffff !important;
  text-shadow: 0 0 10px rgba(255, 255, 255, 0.2);
}
.MJX-TEX {
  font-size: clamp(0.8rem, 4vw, 1.8rem) !important;
}

/* ------- [카드 및 입력창] ------- */
.lab-principles {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  margin-top: 30px;
}
.lab-result-card {
  background: #141517 !important; /* 배경보다 더 깊은 어둠으로 집중도 향상 */
  border: 2px solid var(--lab-primary);
  padding: 40px 20px;
  border-radius: 16px;
  text-align: center;
  box-shadow: 0 0 25px rgba(56, 152, 255, 0.15); /* 은은한 파란색 광채 */
}
.lab-result-focus::after {
  /* content: '↓ 점수는 아래에서 확인됩니다'; */
  display: block;
  font-size: 0.7rem;
  opacity: 0.4;
  margin-top: 8px;
}
.lab-card {
  background: var(--entry);
  border: 1px solid var(--border);
  padding: 20px;
  border-radius: 10px;
  color: var(--primary);
  transition: transform 0.2s;
}
.lab-card:hover {
  transform: translateY(-5px);
  border-color: #0056b3;
}

.lab-input-group {
  background: var(--entry);
  padding: 20px;
  border-radius: 12px;
  margin-bottom: 10px;
  border: 1px solid var(--border);
}

.lab-input {
  display: block;
  width: 100%;
  padding: 12px;
  background: var(--theme); /* 배경보다 한 단계 더 어두운 색상 */
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--primary);
  font-size: 1rem;
}

.score-guide-box {
  display: flex;
  justify-content: space-around;
  margin-top: 20px;
  padding-top: 20px;
  border-top: 1px dashed rgba(255, 255, 255, 0.2);
  font-size: 0.85rem;
  text-align: center;
}
.score-item strong {
  display: block;
  font-size: 1.1em;
  margin-bottom: 4px;
}
.score-safe {
  color: #00c853;
}
.score-warn {
  color: #ffd600;
}
.score-danger {
  color: #ff5252;
}

/* 모바일 대응 */
@media (max-width: 480px) {
  .score-guide-box {
    flex-direction: column;
    gap: 10px;
  }
}

/* ------ [스탭퍼] ------ */
.lab-stepper {
  display: flex;
  justify-content: space-between;
  position: relative;
  margin-bottom: 10px;
}
.lab-stepper-wrap {
  max-width: 600px;
  margin: 0 auto 50px auto;
  padding: 0 10px;
}
.lab-stepper::before {
  content: '';
  position: absolute;
  top: 15px;
  left: 0;
  right: 0;
  height: 2px;
  background: #eee;
  z-index: 1;
}
.lab-step-dot {
  position: relative;
  z-index: 2;
  background: #fff;
  width: 30px;
  height: 30px;
  border-radius: 50%;
  border: 2px solid #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.8rem;
  color: #ccc;
  transition: all 0.3s;
  text-decoration: none;
}
.lab-step-dot:hover {
  border-color: #0056b3;
  color: #0056b3;
}
.lab-step-dot.active {
  border-color: #0056b3;
  background: #0056b3;
  color: #fff;
  transform: scale(1.1);
}
.lab-step-dot.done {
  border-color: #0056b3;
  color: #0056b3;
}
.lab-step-labels {
  display: flex;
  justify-content: space-between;
}
.lab-step-label {
  font-size: 0.75rem;
  color: #999;
  width: 60px;
